# Local development URL (see vite.config.ts)
VITE_APP_URL=http://localhost:5180

# Legacy local database connection string used in early experiments.
VITE_DATABASE_URL=Server=(localdb)\MSSQLLocalDB;Database=EventGallery_Local;Trusted_Connection=True;TrustServerCertificate=True

# Data mode:
# local    - current demo/localStorage mode
# appwrite - future backend mode
VITE_DATA_MODE=local

# Public Appwrite frontend settings for future integration.
# Do not place server API keys or secrets in this file.
VITE_APPWRITE_ENDPOINT=http://localhost/v1
VITE_APPWRITE_PROJECT_ID=event-gallery
VITE_APPWRITE_DATABASE_ID=event_gallery_db
VITE_APPWRITE_BUCKET_ID=event_gallery_photos

# ---------------------------------------------------------------------------
# SMTP / email OTP — NOT for this file
# ---------------------------------------------------------------------------
# Letters are sent by your Appwrite server (createEmailToken), not by Vue.
# Put _APP_SMTP_HOST, _APP_SMTP_PORT, _APP_SMTP_SECURE, _APP_SMTP_USERNAME,
# _APP_SMTP_PASSWORD, _APP_SYSTEM_EMAIL_ADDRESS in the .env of your Appwrite
# Docker installation, then restart Appwrite. See docs/email-otp-setup.md
# ---------------------------------------------------------------------------
