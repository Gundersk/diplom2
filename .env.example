# URL локальной разработки (порт задаётся в vite.config.ts)
VITE_APP_URL=http://localhost:5180

# Строка подключения к локальной БД — для ранних экспериментов, фронтенд MVP её не использует.
VITE_DATABASE_URL=Server=(localdb)\MSSQLLocalDB;Database=EventGallery_Local;Trusted_Connection=True;TrustServerCertificate=True

# Режим данных:
# local    — демо на localStorage и IndexedDB (по умолчанию)
# appwrite — backend через Appwrite Auth / Database / Storage
VITE_DATA_MODE=local

# Публичные настройки Appwrite для фронтенда (без секретов и API-ключей).
VITE_APPWRITE_ENDPOINT=http://localhost/v1
VITE_APPWRITE_PROJECT_ID=event-gallery
VITE_APPWRITE_DATABASE_ID=event_gallery_db
VITE_APPWRITE_BUCKET_ID=event_gallery_photos

# ---------------------------------------------------------------------------
# SMTP / OTP по email — НЕ в этом файле
# ---------------------------------------------------------------------------
# Письма отправляет сервер Appwrite (createEmailToken), а не Vue.
# Переменные _APP_SMTP_HOST, _APP_SMTP_PORT, _APP_SMTP_SECURE, _APP_SMTP_USERNAME,
# _APP_SMTP_PASSWORD, _APP_SYSTEM_EMAIL_ADDRESS — в .env установки Appwrite (Docker),
# затем перезапуск контейнеров. Подробнее: docs/email-otp-setup.md
# ---------------------------------------------------------------------------
