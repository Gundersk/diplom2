# Локальные секреты для скрипта npm run setup:appwrite (не коммитить, см. .gitignore).
# Скопируйте в .env.setup и подставьте API Key из Appwrite Console → Settings → API Keys.

APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=ellary
APPWRITE_DATABASE_ID=ellary_db
APPWRITE_BUCKET_ID=event_gallery_photos
APPWRITE_API_KEY=replace_with_your_appwrite_api_key
